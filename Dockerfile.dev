FROM node:22-bookworm-slim
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    KOKORO_ENSURE=""
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/cosight
COPY package.json package-lock.json ./
RUN npm ci && npx playwright install --with-deps chromium
RUN mkdir -p /workspace /data /opt/cosight/node_modules/.vitest-cache /opt/cosight/node_modules/.vite && chown node:node /workspace /data /opt/cosight/node_modules/.vitest-cache /opt/cosight/node_modules/.vite
# Native Electron smoke tests use only a private Xvfb display in this container.
RUN apt-get update && apt-get install -y --no-install-recommends libgtk-3-0 xauth && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
USER node
EXPOSE 8099
CMD ["sh", "scripts/worker-web-entrypoint.sh"]

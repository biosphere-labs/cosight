{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "hooks/canvas.ts",
    "hooks/gapstyle.ts",
    "hooks/tour.ts",
    "types",
    "tests/*.test.ts"
  ],
  "exclude": [
    "tests/register.test.ts"
  ]
}
